# Crypto Tracker Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# API KEYS (Legacy - will be migrated to secrets manager)
# =============================================================================

# Binance API Keys (fallback for backward compatibility)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Exchange-specific API Keys (will be used by secrets manager)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here

KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here

# =============================================================================
# SECRETS MANAGEMENT
# =============================================================================

# Master password for local encrypted secrets storage
# REQUIRED for local_encrypted backend
SECRETS_MASTER_PASSWORD=your_secure_master_password_here

# HashiCorp Vault Configuration (optional)
VAULT_URL=https://vault.example.com:8200
VAULT_TOKEN=your_vault_token_here

# AWS Secrets Manager Configuration (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# GCP Secret Manager Configuration (optional)
GCP_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Slack Integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Generic Webhook (optional)
NOTIFIER_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
NOTIFIER_WEBHOOK_LEVEL=info

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Security validation settings
SECURITY_VALIDATION_ENABLED=true
SECURITY_MAX_WITHDRAWAL_USD=1000.0
SECURITY_REQUIRE_IP_WHITELIST=true

# =============================================================================
# EXCHANGE-SPECIFIC SETTINGS
# =============================================================================

# Binance specific settings
BINANCE_TESTNET=false
BINANCE_SANDBOX=false

# Coinbase specific settings
COINBASE_SANDBOX=false

# =============================================================================
# DEVELOPMENT/TESTING SETTINGS
# =============================================================================

# Enable debug logging
DEBUG=false
LOG_LEVEL=info

# Testing mode (disables live trading)
TESTING_MODE=false

# Paper trading settings
PAPER_TRADING=true
PAPER_PLACE_ORDERS=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# SQLite database path
DATABASE_PATH=./logs/tracker.db

# =============================================================================
# CACHE SETTINGS
# =============================================================================

# Data cache directory
CACHE_DIR=./data_cache

# Cache TTL settings
PRICE_CACHE_TTL_SECONDS=15
DATA_CACHE_TTL_HOURS=24

# =============================================================================
# RISK MANAGEMENT SETTINGS
# =============================================================================

# Risk limits
MAX_POSITION_SIZE_USD=200.0
MIN_POSITION_SIZE_USD=25.0
MAX_OPEN_POSITIONS=5
RISK_BUDGET_PCT=0.005

# Drawdown limits
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_WEEKLY_DRAWDOWN_PCT=12.0
MAX_DRAWDOWN_PCT=20.0
KILL_SWITCH_DRAWDOWN_PCT=15.0

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================

# Order execution
AUTO_TRADE_ENABLE=true
AUTO_TRADE_MODE=paper
EXECUTOR_RETRY_COUNT=3
EXECUTOR_BACKOFF_FACTOR=0.5

# =============================================================================
# MONITORING SETTINGS
# =============================================================================

# Monitoring intervals
RISK_CHECK_INTERVAL_SECONDS=30
SECURITY_REPORT_INTERVAL_HOURS=24
PORTFOLIO_SUMMARY_INTERVAL_SECONDS=300

# Alert thresholds
EXPOSURE_WARNING_PCT=70.0
DRAWDOWN_WARNING_PCT=10.0
LEVERAGE_WARNING_PCT=80.0

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# CoinGecko API (optional, for price data)
COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinMarketCap API (optional, for price data)
CMC_API_KEY=your_cmc_api_key_here

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Performance settings
ENABLE_PARALLEL_PROCESSING=true
MAX_WORKERS=4
MAX_MEMORY_MB=1024

# Feature flags
ENABLE_ML_FEATURES=false
ENABLE_SENTIMENT_DATA=false
ENABLE_ON_CHAIN_DATA=false
ENABLE_PORTFOLIO_OPTIMIZATION=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit the actual .env file to version control
# 2. Use strong, unique passwords for SECRETS_MASTER_PASSWORD
# 3. Rotate API keys regularly (every 30-60 days)
# 4. Use IP whitelisting on exchanges when possible
# 5. Enable 2FA on all exchange accounts
# 6. Monitor security alerts regularly
# 7. Test in paper trading mode before going live
# 8. Keep backups of encrypted secrets files
# 9. Document key rotation procedures
# 10. Review security logs regularly
